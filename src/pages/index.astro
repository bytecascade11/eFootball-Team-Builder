---
const title = "eFootball Team Builder";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0e1116" />
  <title>eFootball Team Builder</title>
</head>
<body>
  <p class="hint" id="hint" hidden></p>
  <div class="toast" id="toast" hidden></div>

  <header>
    <button class="squad" id="squadBtn" type="button">
      <b id="squadName"></b>
      <small>Switch squad</small>
    </button>
    <select id="formation" aria-label="Formation"></select>
  </header>

  <section class="summary">
    <div class="rating"><b id="avg">--</b><span>Team rating</span></div>
    <div class="lines">
      <div><b id="def">--</b><span>Defence</span></div>
      <div><b id="mid">--</b><span>Midfield</span></div>
      <div><b id="att">--</b><span>Attack</span></div>
    </div>
  </section>
  <p class="meta" id="meta"></p>

  <label class="field">Team playstyle
    <select id="style"></select>
  </label>

  <div class="pitch">
    <i class="ln half"></i><i class="ln circle"></i>
    <i class="ln box t"></i><i class="ln six t"></i>
    <i class="ln box b"></i><i class="ln six b"></i>
    <div id="slots"></div>
  </div>

  <h2 class="sec">Bench</h2>
  <div class="bench" id="bench"></div>

  <div class="actions">
    <button class="btn" id="copy" type="button">Copy lineup</button>
    <button class="btn ghost" id="backup" type="button">Backup</button>
    <button class="btn ghost" id="restore" type="button">Restore</button>
    <button class="btn ghost" id="clear" type="button">Clear</button>
  </div>

  <!-- Player editor -->
  <div class="sheet" id="edit" hidden>
    <div class="panel">
      <h2 id="editTitle">Player</h2>
      <input id="name" list="recents" placeholder="Player name" autocomplete="off" maxlength="30" />
      <datalist id="recents"></datalist>
      <div class="two">
        <input id="rating" type="number" inputmode="numeric" min="40" max="125" placeholder="Rating" />
        <select id="pstyle" aria-label="Player playstyle"></select>
      </div>
      <div class="chips" id="chips"></div>
      <label class="check" id="capRow"><input type="checkbox" id="cap" /> Captain</label>
      <div class="actions">
        <button class="btn" id="save" type="button">Save</button>
        <button class="btn ghost" id="move" type="button">Move</button>
        <button class="btn ghost" id="remove" type="button">Remove</button>
      </div>
    </div>
  </div>

  <!-- Squad manager -->
  <div class="sheet" id="squads" hidden>
    <div class="panel">
      <h2>Squads</h2>
      <div class="list" id="squadList"></div>
      <div class="actions">
        <button class="btn" id="newSquad" type="button">New</button>
        <button class="btn ghost" id="rename" type="button">Rename</button>
        <button class="btn ghost" id="dupe" type="button">Duplicate</button>
        <button class="btn ghost" id="del" type="button">Delete</button>
      </div>
    </div>
  </div>

  <script>
    // ---------- Data ----------
    // [position, x%, y%]. Slot 0 is always the goalkeeper.
    const FORMATIONS = {
      "4-3-3": [["GK",50,90],["LB",14,72],["CB",38,75],["CB",62,75],["RB",86,72],["CMF",26,52],["DMF",50,58],["CMF",74,52],["LWF",16,24],["CF",50,16],["RWF",84,24]],
      "4-2-3-1": [["GK",50,90],["LB",14,72],["CB",38,75],["CB",62,75],["RB",86,72],["DMF",34,57],["DMF",66,57],["LMF",16,36],["AMF",50,36],["RMF",84,36],["CF",50,15]],
      "4-4-2": [["GK",50,90],["LB",14,72],["CB",38,75],["CB",62,75],["RB",86,72],["LMF",14,50],["CMF",38,52],["CMF",62,52],["RMF",86,50],["CF",36,18],["CF",64,18]],
      "4-1-2-3": [["GK",50,90],["LB",14,72],["CB",38,75],["CB",62,75],["RB",86,72],["DMF",50,60],["CMF",30,46],["CMF",70,46],["LWF",16,22],["CF",50,15],["RWF",84,22]],
      "3-5-2": [["GK",50,90],["CB",24,75],["CB",50,77],["CB",76,75],["LMF",9,50],["CMF",31,53],["DMF",50,59],["CMF",69,53],["RMF",91,50],["CF",36,18],["CF",64,18]],
      "3-4-3": [["GK",50,90],["CB",24,75],["CB",50,77],["CB",76,75],["LMF",14,52],["CMF",38,55],["CMF",62,55],["RMF",86,52],["LWF",18,22],["CF",50,15],["RWF",82,22]],
      "5-3-2": [["GK",50,90],["LB",10,66],["CB",30,75],["CB",50,77],["CB",70,75],["RB",90,66],["CMF",28,50],["CMF",50,52],["CMF",72,50],["CF",36,18],["CF",64,18]],
    };
    const GROUP = { GK:"GK", LB:"DEF", CB:"DEF", RB:"DEF", DMF:"MID", CMF:"MID", LMF:"MID", RMF:"MID", AMF:"MID", LWF:"ATT", RWF:"ATT", CF:"ATT" };
    const CARDS = ["Standard", "Featured", "Epic", "Big Time", "Legend"];
    const CARD_CLASS = { "Standard":"c-std", "Featured":"c-feat", "Epic":"c-epic", "Big Time":"c-bt", "Legend":"c-leg" };
    const TEAM_STYLES = ["Possession Game", "Quick Counter", "Long Ball Counter", "Out Wide", "Long Ball"];
    const STYLES = [
      "Goal Poacher", "Fox in the Box", "Dummy Runner", "Target Man", "Extra Frontman",
      "Prolific Winger", "Roaming Flank", "Cross Specialist", "Creative Playmaker",
      "Classic No. 10", "Hole Player", "Box-to-Box", "Orchestrator", "Anchor Man",
      "The Destroyer", "Build Up", "Offensive Full-back", "Defensive Full-back",
      "Offensive Goalkeeper", "Defensive Goalkeeper",
    ];
    const KEY = "efb-v2";

    // ---------- Helpers ----------
    const $ = (id) => document.getElementById(id);
    const el = (tag, cls = "", text = "") => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const uid = () => Math.random().toString(36).slice(2, 9);
    const newSquad = (name = "Squad 1") => ({
      id: uid(), name, formation: "4-3-3", style: TEAM_STYLES[0],
      players: Array(11).fill(null), bench: Array(7).fill(null), captain: -1,
    });
    const clean = (p) =>
      p && typeof p.name === "string" && p.name
        ? {
            name: p.name.slice(0, 30),
            rating: Math.min(125, Math.max(0, parseInt(p.rating, 10) || 0)),
            card: CARDS.includes(p.card) ? p.card : "Standard",
            style: typeof p.style === "string" ? p.style : "",
          }
        : null;

    function normalize(d) {
      const out = { squads: [], current: d.current, recents: [] };
      if (Array.isArray(d.recents)) out.recents = d.recents.map(clean).filter(Boolean).slice(0, 100);
      (Array.isArray(d.squads) ? d.squads : []).forEach((s) => {
        const b = newSquad(String(s.name || "Squad").slice(0, 24));
        if (s.id) b.id = String(s.id);
        if (FORMATIONS[s.formation]) b.formation = s.formation;
        if (TEAM_STYLES.includes(s.style)) b.style = s.style;
        b.players = b.players.map((_, i) => clean(s.players && s.players[i]));
        b.bench = b.bench.map((_, i) => clean(s.bench && s.bench[i]));
        b.captain = Number.isInteger(s.captain) && s.captain >= 0 && s.captain < 11 ? s.captain : -1;
        out.squads.push(b);
      });
      if (!out.squads.length) out.squads.push(newSquad());
      if (!out.squads.some((s) => s.id === out.current)) out.current = out.squads[0].id;
      return out;
    }

    // ---------- State ----------
    let db = normalize({});
    try {
      const saved = JSON.parse(localStorage.getItem(KEY));
      if (saved) db = normalize(saved);
    } catch {}
    let swapFrom = null; // { zone: "p" | "b", i }
    let editRef = null;
    let draftCard = "Standard";
    let toastTimer;

    const sq = () => db.squads.find((s) => s.id === db.current);
    const list = (ref) => (ref.zone === "p" ? sq().players : sq().bench);
    const save = () => localStorage.setItem(KEY, JSON.stringify(db));
    const show = (id) => ($(id).hidden = false);
    const hide = (id) => ($(id).hidden = true);

    function toast(msg) {
      const t = $("toast");
      t.textContent = msg;
      t.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => (t.hidden = true), 1800);
    }

    // ---------- Rendering ----------
    function cardEl(p, label, ref, isCap) {
      const b = el("button", "card " + (p ? CARD_CLASS[p.card] || "c-std" : "empty"));
      b.type = "button";
      if (swapFrom && swapFrom.zone === ref.zone && swapFrom.i === ref.i) b.classList.add("lift");
      b.append(el("span", "r", p ? String(p.rating || "?") : "+"), el("span", "pos", label), el("span", "nm", p ? p.name : ""));
      if (isCap) b.append(el("span", "cap", "C"));
      b.onclick = () => tap(ref);
      return b;
    }

    function stats(s) {
      const rows = [];
      s.players.forEach((p, i) => {
        if (p) rows.push({ p, g: GROUP[FORMATIONS[s.formation][i][0]] });
      });
      const rated = rows.filter((x) => x.p.rating > 0);
      const avg = (a) => (a.length ? (a.reduce((t, x) => t + x.p.rating, 0) / a.length).toFixed(1) : "--");
      $("avg").textContent = avg(rated);
      $("def").textContent = avg(rated.filter((x) => x.g === "DEF"));
      $("mid").textContent = avg(rated.filter((x) => x.g === "MID"));
      $("att").textContent = avg(rated.filter((x) => x.g === "ATT"));
      let meta = rows.length + "/11 starters";
      if (rated.length > 1) {
        const sorted = [...rated].sort((a, b) => b.p.rating - a.p.rating);
        const top = sorted[0].p, low = sorted[sorted.length - 1].p;
        meta += " · Top: " + top.name + " " + top.rating + " · Lowest: " + low.name + " " + low.rating;
      }
      $("meta").textContent = meta;
    }

    function render() {
      const s = sq();
      $("squadName").textContent = s.name;
      $("formation").value = s.formation;
      $("style").value = s.style;

      const slots = $("slots");
      slots.replaceChildren();
      FORMATIONS[s.formation].forEach(([pos, x, y], i) => {
        const wrap = el("div", "slot");
        wrap.style.left = x + "%";
        wrap.style.top = y + "%";
        wrap.append(cardEl(s.players[i], pos, { zone: "p", i }, s.captain === i));
        slots.append(wrap);
      });

      const bench = $("bench");
      bench.replaceChildren();
      s.bench.forEach((p, i) => bench.append(cardEl(p, "SUB", { zone: "b", i }, false)));

      stats(s);

      const h = $("hint");
      h.hidden = !swapFrom;
      if (swapFrom) {
        const p = list(swapFrom)[swapFrom.i];
        h.textContent = "Moving " + (p ? p.name : "slot") + ". Tap another slot to swap, or tap it again to cancel.";
      }
      save();
    }

    function fillRecents() {
      const dl = $("recents");
      dl.replaceChildren();
      db.recents.forEach((r) => dl.append(new Option(r.name, r.name)));
    }

    // ---------- Interactions ----------
    function swap(a, b) {
      const s = sq();
      const A = list(a), B = list(b);
      [A[a.i], B[b.i]] = [B[b.i], A[a.i]];
      // the captain band follows the player
      if (a.zone === "p" && s.captain === a.i) s.captain = b.zone === "p" ? b.i : -1;
      else if (b.zone === "p" && s.captain === b.i) s.captain = a.zone === "p" ? a.i : -1;
    }

    function tap(ref) {
      if (swapFrom) {
        const same = swapFrom.zone === ref.zone && swapFrom.i === ref.i;
        if (!same) swap(swapFrom, ref);
        swapFrom = null;
        render();
        return;
      }
      openEdit(ref);
    }

    function setCard(c) {
      draftCard = c;
      document.querySelectorAll("#chips .chip").forEach((b) => b.classList.toggle("sel", b.dataset.card === c));
    }

    function openEdit(ref) {
      editRef = ref;
      const s = sq();
      const p = list(ref)[ref.i];
      $("editTitle").textContent = ref.zone === "p" ? FORMATIONS[s.formation][ref.i][0] : "Substitute " + (ref.i + 1);
      $("name").value = p ? p.name : "";
      $("rating").value = p && p.rating ? p.rating : "";
      $("pstyle").value = p ? p.style || "" : "";
      setCard(p ? p.card : "Standard");
      $("capRow").hidden = ref.zone !== "p";
      $("cap").checked = ref.zone === "p" && s.captain === ref.i;
      $("move").hidden = !p;
      $("remove").hidden = !p;
      show("edit");
      $("name").focus();
    }

    function remember(p) {
      const k = p.name.toLowerCase();
      db.recents = [p, ...db.recents.filter((r) => r.name.toLowerCase() !== k)].slice(0, 100);
      fillRecents();
    }

    // Autofill from players you've entered before
    $("name").addEventListener("input", () => {
      const k = $("name").value.trim().toLowerCase();
      const m = db.recents.find((r) => r.name.toLowerCase() === k);
      if (m && !$("rating").value) {
        $("rating").value = m.rating || "";
        $("pstyle").value = m.style || "";
        setCard(m.card);
      }
    });

    $("save").onclick = () => {
      const name = $("name").value.trim();
      if (!name) return toast("Enter a player name");
      let r = parseInt($("rating").value, 10);
      r = isNaN(r) ? 0 : Math.min(125, Math.max(40, r));
      const p = { name, rating: r, card: draftCard, style: $("pstyle").value };
      const s = sq();
      list(editRef)[editRef.i] = p;
      if (editRef.zone === "p") {
        if ($("cap").checked) s.captain = editRef.i;
        else if (s.captain === editRef.i) s.captain = -1;
      }
      remember(p);
      hide("edit");
      render();
    };

    $("remove").onclick = () => {
      const s = sq();
      list(editRef)[editRef.i] = null;
      if (editRef.zone === "p" && s.captain === editRef.i) s.captain = -1;
      hide("edit");
      render();
    };

    $("move").onclick = () => {
      swapFrom = editRef;
      hide("edit");
      render();
    };

    document.querySelectorAll(".sheet").forEach((sh) =>
      sh.addEventListener("click", (e) => {
        if (e.target === sh) sh.hidden = true;
      })
    );

    $("formation").onchange = () => { sq().formation = $("formation").value; render(); };
    $("style").onchange = () => { sq().style = $("style").value; render(); };

    $("clear").onclick = () => {
      if (!confirm("Clear all players in this squad?")) return;
      const s = sq();
      s.players = Array(11).fill(null);
      s.bench = Array(7).fill(null);
      s.captain = -1;
      swapFrom = null;
      render();
    };

    // ---------- Squads ----------
    function renderSquadList() {
      const box = $("squadList");
      box.replaceChildren();
      db.squads.forEach((s) => {
        const b = el("button", "sqrow" + (s.id === db.current ? " on" : ""));
        b.type = "button";
        const n = s.players.filter(Boolean).length;
        b.append(el("b", "", s.name), el("small", "", s.formation + " · " + n + "/11"));
        b.onclick = () => {
          db.current = s.id;
          swapFrom = null;
          hide("squads");
          render();
        };
        box.append(b);
      });
    }

    $("squadBtn").onclick = () => { renderSquadList(); show("squads"); };

    $("newSquad").onclick = () => {
      const n = newSquad("Squad " + (db.squads.length + 1));
      db.squads.push(n);
      db.current = n.id;
      swapFrom = null;
      hide("squads");
      render();
    };

    $("rename").onclick = () => {
      const name = prompt("Squad name", sq().name);
      if (name && name.trim()) {
        sq().name = name.trim().slice(0, 24);
        renderSquadList();
        render();
      }
    };

    $("dupe").onclick = () => {
      const copy = JSON.parse(JSON.stringify(sq()));
      copy.id = uid();
      copy.name = (copy.name + " copy").slice(0, 24);
      db.squads.push(copy);
      db.current = copy.id;
      hide("squads");
      render();
    };

    $("del").onclick = () => {
      if (db.squads.length < 2) return toast("Keep at least one squad");
      if (!confirm("Delete \"" + sq().name + "\"?")) return;
      db.squads = db.squads.filter((s) => s.id !== db.current);
      db.current = db.squads[0].id;
      swapFrom = null;
      hide("squads");
      render();
    };

    // ---------- Copy, backup, restore ----------
    async function copyText(text, ok) {
      try {
        await navigator.clipboard.writeText(text);
        toast(ok);
      } catch {
        const t = document.createElement("textarea");
        t.value = text;
        document.body.append(t);
        t.select();
        let done = false;
        try { done = document.execCommand("copy"); } catch {}
        t.remove();
        toast(done ? ok : "Copy failed");
      }
    }

    const fmt = (p) => p.name + (p.rating ? " " + p.rating : "") + (p.style ? " (" + p.style + ")" : "");

    $("copy").onclick = () => {
      const s = sq();
      const L = [s.name + " - " + s.formation + ", " + s.style, "Team rating: " + $("avg").textContent, ""];
      FORMATIONS[s.formation].forEach(([pos], i) => {
        const p = s.players[i];
        L.push(pos + ": " + (p ? fmt(p) + (s.captain === i ? " [C]" : "") : "-"));
      });
      const subs = s.bench.filter(Boolean);
      if (subs.length) {
        L.push("", "Bench:");
        subs.forEach((p) => L.push(fmt(p)));
      }
      copyText(L.join("\n"), "Lineup copied");
    };

    $("backup").onclick = () => copyText(JSON.stringify(db), "Backup copied. Paste it somewhere safe");

    $("restore").onclick = () => {
      const raw = prompt("Paste your backup text");
      if (!raw) return;
      try {
        const d = JSON.parse(raw);
        if (!Array.isArray(d.squads) || !d.squads.length) throw new Error("bad");
        db = normalize(d);
        swapFrom = null;
        fillRecents();
        render();
        toast("Backup restored");
      } catch {
        toast("That backup is not valid");
      }
    };

    // ---------- Init ----------
    Object.keys(FORMATIONS).forEach((f) => $("formation").add(new Option(f, f)));
    TEAM_STYLES.forEach((t) => $("style").add(new Option(t, t)));
    $("pstyle").add(new Option("No playstyle", ""));
    STYLES.forEach((t) => $("pstyle").add(new Option(t, t)));
    CARDS.forEach((c) => {
      const b = el("button", "chip " + CARD_CLASS[c], c);
      b.type = "button";
      b.dataset.card = c;
      b.onclick = () => setCard(c);
      $("chips").append(b);
    });
    fillRecents();
    render();
  </script>

  <style is:global>
    :root {
      --night: #0e1116;
      --panel: #171c25;
      --line: #2a3140;
      --chalk: #e9efe6;
      --mute: #8d98a8;
      --turf: #1b5a40;
      --turf2: #17503a;
      --cond: "sans-serif-condensed", "Roboto Condensed", "Arial Narrow", system-ui, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; -webkit-tap-highlight-color: transparent; }
    [hidden] { display: none !important; }
    body {
      font-family: system-ui, sans-serif; background: var(--night); color: var(--chalk);
      min-height: 100vh; padding: env(safe-area-inset-top) 14px calc(env(safe-area-inset-bottom) + 28px);
    }
    button { font: inherit; color: inherit; }
    select, input {
      background: var(--panel); color: var(--chalk); border: 1px solid var(--line);
      border-radius: 10px; padding: 11px 12px; font-size: 16px; width: 100%;
    }

    header { display: flex; gap: 10px; align-items: center; padding: 14px 0 10px; }
    header select { width: auto; min-width: 104px; font-weight: 700; }
    .squad {
      flex: 1; min-width: 0; text-align: left; background: var(--panel); border: 1px solid var(--line);
      border-radius: 12px; padding: 8px 12px; display: grid;
    }
    .squad b { font: 800 19px/1.15 var(--cond); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .squad small { color: var(--mute); font-size: 12px; }

    .summary { display: flex; gap: 10px; align-items: stretch; }
    .rating {
      background: var(--chalk); color: var(--night); border-radius: 14px; padding: 10px 16px;
      display: grid; align-content: center; justify-items: center; min-width: 112px;
    }
    .rating b { font: 800 40px/1 var(--cond); }
    .rating span { font-size: 12px; font-weight: 600; }
    .lines { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .lines div { background: var(--panel); border-radius: 12px; display: grid; align-content: center; justify-items: center; padding: 8px 4px; }
    .lines b { font: 800 22px/1.1 var(--cond); }
    .lines span { color: var(--mute); font-size: 11px; }
    .meta { color: var(--mute); font-size: 12px; margin: 8px 2px 10px; min-height: 16px; }
    .field { display: grid; gap: 6px; color: var(--mute); font-size: 13px; margin-bottom: 12px; }
    .field select { color: var(--chalk); font-weight: 600; }

    .pitch {
      position: relative; aspect-ratio: 3 / 4; border-radius: 14px; overflow: hidden;
      background: repeating-linear-gradient(var(--turf) 0 12.5%, var(--turf2) 12.5% 25%);
      border: 2px solid rgba(233, 239, 230, 0.5);
    }
    .ln { position: absolute; border: 2px solid rgba(233, 239, 230, 0.32); pointer-events: none; }
    .ln.half { left: 0; right: 0; top: 50%; border-width: 2px 0 0; }
    .ln.circle { left: 50%; top: 50%; width: 26%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); }
    .ln.box { left: 50%; width: 56%; height: 17%; transform: translateX(-50%); }
    .ln.six { left: 50%; width: 28%; height: 7%; transform: translateX(-50%); }
    .ln.t { top: -2px; border-top: 0; }
    .ln.b { bottom: -2px; border-bottom: 0; }
    #slots { position: absolute; inset: 0; }
    .slot { position: absolute; transform: translate(-50%, -50%); }

    .card {
      --tier: #d9dee4; --tx: #14181f;
      position: relative; width: 56px; height: 68px; padding: 5px 3px 4px; border: 0;
      border-radius: 7px 7px 16px 16px; background: var(--tier); color: var(--tx);
      display: flex; flex-direction: column; align-items: center; justify-content: space-between;
      box-shadow: 0 3px 0 rgba(0, 0, 0, 0.35); transition: transform 0.15s;
    }
    .card .r { font: 800 21px/1 var(--cond); }
    .card .pos { font-size: 9px; font-weight: 700; opacity: 0.75; }
    .card .nm { font-size: 10px; font-weight: 700; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-height: 12px; }
    .card.empty { background: rgba(255, 255, 255, 0.07); color: var(--chalk); border: 1.5px dashed rgba(233, 239, 230, 0.55); box-shadow: none; }
    .card.empty .r { font-weight: 500; opacity: 0.8; }
    .card.lift { transform: translateY(-7px) scale(1.08); outline: 2px solid var(--chalk); z-index: 2; }
    .card .cap {
      position: absolute; top: -7px; right: -7px; width: 19px; height: 19px; border-radius: 50%;
      background: var(--night); color: var(--chalk); border: 1.5px solid var(--chalk);
      font: 800 11px/16px var(--cond); text-align: center;
    }
    .c-std { --tier: #d9dee4; --tx: #14181f; }
    .c-feat { --tier: #4aa3ff; --tx: #06213d; }
    .c-epic { --tier: #a974ff; --tx: #200a45; }
    .c-bt { --tier: #ff5a6a; --tx: #3a0710; }
    .c-leg { --tier: #f2c14e; --tx: #3a2800; }

    .sec { font: 800 16px var(--cond); margin: 18px 2px 8px; }
    .bench { display: flex; gap: 10px; overflow-x: auto; padding: 8px 4px 12px; margin: 0 -4px; }
    .bench .card { flex: 0 0 auto; }

    .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .btn {
      flex: 1 1 0; min-width: 0; padding: 13px 8px; border: 0; border-radius: 12px;
      background: var(--chalk); color: var(--night); font-weight: 700;
    }
    .btn.ghost { background: var(--panel); color: var(--chalk); border: 1px solid var(--line); }
    .btn:active { transform: scale(0.97); }

    .sheet { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.65); display: flex; align-items: flex-end; z-index: 20; }
    .panel {
      width: 100%; max-height: 90vh; overflow-y: auto; background: #10151d; border-radius: 20px 20px 0 0;
      padding: 18px 16px calc(env(safe-area-inset-bottom) + 18px); display: grid; gap: 10px;
    }
    .panel h2 { font: 800 20px var(--cond); }
    .two { display: grid; grid-template-columns: 110px 1fr; gap: 8px; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { border: 0; border-radius: 999px; padding: 8px 14px; background: var(--tier); color: var(--tx); font-size: 13px; font-weight: 700; opacity: 0.55; }
    .chip.sel { opacity: 1; outline: 2px solid var(--chalk); outline-offset: 2px; }
    .check { display: flex; align-items: center; gap: 10px; font-weight: 600; }
    .check input { width: 22px; height: 22px; accent-color: var(--chalk); }
    .list { display: grid; gap: 8px; }
    .sqrow { text-align: left; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; }
    .sqrow b { font: 800 17px var(--cond); }
    .sqrow small { color: var(--mute); }
    .sqrow.on { border-color: var(--chalk); }

    .hint {
      position: fixed; top: calc(env(safe-area-inset-top) + 8px); left: 12px; right: 12px; z-index: 30;
      background: var(--chalk); color: var(--night); padding: 10px 14px; border-radius: 12px;
      font-weight: 700; font-size: 14px; text-align: center;
    }
    .toast {
      position: fixed; bottom: calc(env(safe-area-inset-bottom) + 20px); left: 50%; transform: translateX(-50%);
      z-index: 40; background: var(--chalk); color: var(--night); padding: 10px 18px; border-radius: 999px;
      font-weight: 700; font-size: 14px; max-width: 90vw; text-align: center;
    }
    @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
  </style>
</body>
</html>
